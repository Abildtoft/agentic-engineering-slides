# Get your API key from https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Get your API key from https://aistudio.google.com
GEMINI_API_KEY=

# Narrated auto-mode (`yarn narration:build`). The IDs are account-scoped
# resource identifiers, not secrets; the key is the secret.
# Key: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=
# Must support the Starfish engine, or /v3/voices/speech returns no
# word_timestamps and every cue falls back to even spacing:
#   curl -H "X-Api-Key: $HEYGEN_API_KEY" https://api.heygen.com/v3/voices?engine=starfish
HEYGEN_VOICE_ID=
HEYGEN_AVATAR_ID=
