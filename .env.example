# Get your API key from https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Get your API key from https://aistudio.google.com
GEMINI_API_KEY=

# Vercel's server-side access gate. Set both values in the Vercel dashboard for
# every protected environment, then redeploy. Use a numeric PIN for the intended
# keypad experience and generate the signing secret with: openssl rand -base64 32
DECK_ACCESS_PIN=
DECK_COOKIE_SECRET=
# Emergency bypass. Leave unset normally; setting true requires a redeploy.
DISABLE_PIN_GATE=

# Deployed-deck analytics. The project key is intentionally public and is
# embedded in the browser bundle. Configure these for Vercel Production only
# to keep local sessions and preview deployments out of PostHog. The client
# uses localStorage-only persistence, sets no PostHog cookies, and disables
# session recording.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Narrated auto-mode speech (`yarn narration:audio`) — ElevenLabs TTS.
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# The voice id is an account-scoped resource identifier, not a secret. The
# default is "Eric — Smooth, Trustworthy", ElevenLabs' premade friendly,
# conversational American male. `yarn narration:voices --list` prints
# alternatives, and the bare preflight verifies whatever is configured here.
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
# eleven_v3 is the expressive model; alignment timestamps come back for it via
# the with-timestamps endpoint, which is what times the [click] cues.
ELEVENLABS_MODEL_ID=eleven_v3
# eleven_v3 reads stability as three modes, not a slider:
# 0.0 Creative (most expressive), 0.5 Natural, 1.0 Robust.
ELEVENLABS_STABILITY=0.5
# Pace baked into the audio with ffmpeg atempo (pitch-preserving); every cue,
# word timing and caption is scaled to match. 1.0 = the voice's natural pace.
# Needs ffmpeg on PATH whenever it isn't 1.0.
NARRATION_PACE=1.1

# Mascot narration (`yarn narration:mascot`). A development key: the render runs
# on localhost, the only origin a mascot_dev_ key accepts, and the deck ships
# the rendered video rather than the SDK. The same key authenticates the
# private npm registry (.yarnrc.yml reads it from the environment), so export
# it before `yarn install`: MASCOT_API_KEY=… yarn install
# Key: https://app.mascot.bot/api-keys
MASCOT_API_KEY=
