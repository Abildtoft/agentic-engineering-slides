{
  "name": "agentic-engineering-slides",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "slidev --open",
    "dev:melatech": "slidev slides-melatech.md --open",
    "build": "slidev build",
    "build:melatech": "slidev build slides-melatech.md",
    "export": "slidev export",
    "export:melatech": "slidev export slides-melatech.md",
    "test": "node --test tests/*.test.mjs",
    "test:deck": "node --test tests/deck-parity.test.mjs",
    "test:access": "node --test tests/pin-gate.test.mjs",
    "test:narration": "node --test tests/narration-*.test.mjs",
    "verify": "yarn test && yarn build && yarn build:melatech",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "narration:scaffold": "node scripts/narration-scaffold.mjs",
    "narration:build": "node --env-file-if-exists=.env scripts/narration-build.mjs",
    "narration:audio": "node --env-file-if-exists=.env scripts/narration-build.mjs",
    "narration:voices": "node --env-file-if-exists=.env scripts/narration-voices.mjs",
    "narration:captions": "node scripts/narration-captions.mjs",
    "narration:mascot": "node --env-file-if-exists=.env scripts/narration-mascot.mjs"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.80",
    "@slidev/cli": "^52.0.0",
    "@slidev/client": "52.12.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/types": "52.12.0",
    "beautiful-mermaid": "^1.1.3",
    "posthog-js": "^1.418.16",
    "unocss": "66.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@rive-app/webgl2": "^2.40.1",
    "@slidev/parser": "52.12.0",
    "playwright-core": "^1.61",
    "vite": "7.3.1"
  }
}
